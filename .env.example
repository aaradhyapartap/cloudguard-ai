# ---------------------------------------------------------------------------
# Copy to .env. Never commit .env — it is in .gitignore for a reason.
# Deployed environments inject these from Secrets Manager / SSM, never a file.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console                       # console locally, json in AWS
CORS_ORIGINS=http://localhost:3000

# --- Which adapter satisfies each port ------------------------------------
# IDENTITY_PROVIDER=local is refused unless ENVIRONMENT=local. That is a
# startup validator, not a warning: development token signing anywhere else
# is an authentication bypass.
IDENTITY_PROVIDER=local                  # local | cognito
# This block is what makes local development free: with everything on a test
# double, the whole application runs with no AWS account and no network.
LLM_PROVIDER=mock                        # mock | recorded | bedrock
VECTOR_STORE=memory                      # memory | pgvector | s3_vectors
DOCUMENT_STORE=memory                    # memory | s3
EVENT_PUBLISHER=memory                   # memory | eventbridge

# --- Database (matches docker-compose) ------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=cloudguard
DB_PASSWORD=cloudguard
DB_NAME=cloudguard
DB_ECHO_SQL=false

# --- AWS ------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DOCUMENTS_BUCKET=cloudguard-documents-local
AWS_EVENT_BUS_NAME=cloudguard-events
AWS_AUDIT_TABLE_NAME=cloudguard-audit-events
# Populated by the deployed Aurora stack. Local development does not need them.
# AWS_AURORA_CLUSTER_ARN=
# AWS_AURORA_SECRET_ARN=
# Point at LocalStack locally; leave unset to use real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# --- Bedrock (Phase 4) ----------------------------------------------------
# Model IDs are configuration. Verify current IDs in the Bedrock console before
# deploying — they change more often than this file does.
BEDROCK_CHAT_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REASONING_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_JUDGE_MODEL=amazon.nova-pro-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_MAX_OUTPUT_TOKENS=2048
BEDROCK_MAX_INPUT_TOKENS=32000
# BEDROCK_GUARDRAIL_ID=                  # Phase 8
# BEDROCK_GUARDRAIL_VERSION=

# --- Local auth (local environment only) ----------------------------------
# Must be >= 32 bytes (RFC 7518 for HS256). Override the placeholder if you
# like; it can never sign a token that matters, because the validator above
# refuses local auth outside the local environment.
# LOCAL_AUTH_SECRET=local-development-secret-do-not-use-in-any-real-place
# LOCAL_AUTH_TOKEN_TTL_SECONDS=3600

# --- Cognito (required when IDENTITY_PROVIDER=cognito) --------------------
# Values come from `cdk deploy CloudGuardIdentity-dev` stack outputs.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1
# COGNITO_HOSTED_UI_DOMAIN=

# --- Feature flags --------------------------------------------------------
ENABLE_AGENTIC_WORKFLOWS=false
ENABLE_RERANKING=false
ENABLE_ADVANCED_EVALUATION=false
ENABLE_AUTO_REMEDIATION=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_AUTOMATED_REASONING=false
