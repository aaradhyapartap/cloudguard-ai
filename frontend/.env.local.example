# Base URL of the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Nothing else belongs here. Login configuration (issuer, client id, hosted UI
# domain) is fetched from /auth/config at runtime, so rotating a Cognito user
# pool does not require rebuilding the frontend.
#
# The Phase 1 NEXT_PUBLIC_DEV_PRINCIPAL variable is gone: authentication now
# uses real signed tokens in every environment.
